<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Preserve the adaptive icon's 108dp canvas; only the shared mark is visible. -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- 60/108 of the canvas; fractional padding also scales at smaller launcher sizes. -->
    <item>
        <inset
            android:drawable="@drawable/ic_tradebot_mark"
            android:inset="22.2222%" />
    </item>
</layer-list>
